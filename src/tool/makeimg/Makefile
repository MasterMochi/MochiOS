#******************************************************************************#
#******************************************************************************#
#* 設定                                                                       *#
#******************************************************************************#
# 実行ファイル
PROG = makeimg

# ソースコード
SRCS = makeimg.c

# ビルドディレクトリ
BUILD_DIR   = ../../../build
# リリースディレクトリ
RELEASE_DIR = $(BUILD_DIR)/release/tool
# 中間ファイルディレクトリ
OBJ_DIR     = $(BUILD_DIR)/obj/tool

# Cフラグ
CFLAGS   = -m32
CFLAGS  += -I../../kernel/build/release/include/kernel
CFLAGS  += -I../../lib/MLib/build/release/include
CFLAGS  += -I$(BUILD_DIR)/include
# LDフラグ
LDFLAGS  =


#******************************************************************************#
#* phonyターゲット                                                            *#
#******************************************************************************#
# コンパイル
.PHONY: all
all: $(OBJ_DIR) $(RELEASE_DIR)/$(PROG) Makefile

# 全生成ファイルの削除
.PHONY: clean
clean:
	-rm -rf $(RELEASE_DIR)/$(PROG)
	-rm -rf $(OBJ_DIR)/$(PROG)


#******************************************************************************#
#* 生成規則                                                                   *#
#******************************************************************************#
# ディレクトリ
$(OBJ_DIR):
	mkdir -p $@

# 実行ファイル
$(RELEASE_DIR)/$(PROG): $(SRCS) Makefile
	$(CC) $(CFLAGS) -o $(OBJ_DIR)/$(PROG) $(SRCS) $(LDFLAGS) $(LIBS)
	ln -sfr $(OBJ_DIR)/$(PROG) $@


#******************************************************************************#
